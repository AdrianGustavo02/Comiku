#Port del servidor Backend
PORT=3000

#Credenciales de Firebase Admin (desde el JSON de la cuenta de servicio)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

#Lista separada por comas de nombres de campos que pueden contener el uid del usuario en futuras colecciones
USER_REFERENCE_FIELDS=UID,uid,userId,ownerUid

#Credenciales de Stream Chat (https://dashboard.getstream.io)
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret
